# ComfyUI address reachable from this API container/process
COMFYUI_URL=http://127.0.0.1:8188
# Exact published BETANIA origin, e.g. https://OWNER.github.io/REPOSITORY
BETANIA_ORIGIN=*
# Optional override; by default backend/wan2_2_5b_t2v.json is used
# WAN_WORKFLOW_JSON=/app/wan2_2_5b_t2v.json

# Optional: set a long random value to protect job/reference endpoints
BETANIA_API_KEY=replace-with-a-long-random-secret
